{
  "schemaVersion": 1,
  "id": "module-update",
  "title": "本回合功能区更新",
  "description": "前台正文完成后更新本回合需要写入的功能区记录。",
  "kind": "turn-background",
  "revision": "1",
  "defaults": {
    "agentId": "module-updater",
    "modelId": "pi:current",
    "context": { "mode": "fixed" }
  },
  "instancePolicy": { "mode": "single", "maxConcurrentInstances": 1 },
  "trigger": { "type": "after-workflow", "workflowId": "standard-rp" },
  "nodes": [
    {
      "id": "update-modules",
      "title": "更新功能区",
      "type": "module-output",
      "blockNextTurn": true,
      "retry": { "maxAttempts": 3 }
    }
  ]
}
