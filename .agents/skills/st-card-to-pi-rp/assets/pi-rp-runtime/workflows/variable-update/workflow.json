{
  "schemaVersion": 1,
  "id": "variable-update",
  "title": "本回合变量更新",
  "description": "读取完整变量快照，根据最新正文集中更新并校验。",
  "kind": "turn-background",
  "revision": "1",
  "defaults": {
    "agentId": "variable-updater",
    "modelId": "pi:current",
    "context": { "mode": "fixed" }
  },
  "instancePolicy": { "mode": "single", "maxConcurrentInstances": 1 },
  "trigger": { "type": "after-workflow", "workflowId": "module-update" },
  "nodes": [
    {
      "id": "update-variables",
      "title": "更新并校验变量",
      "type": "variable-update",
      "blockNextTurn": true,
      "retry": { "maxAttempts": 3 }
    }
  ]
}
