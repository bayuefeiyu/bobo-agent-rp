    {
      "id": "datacontract.v1.valid",
      "ruleIds": [
        "struct.datacontract.schemaVersion",
        "struct.datacontract.moduleId"
      ],
      "layer": "runtime+cardpack",
      "input": {
        "schemaVersion": 1,
        "moduleId": "demo-module",
        "collections": {
          "entries": {
            "storage": {
              "kind": "record-log",
              "partition": {
                "mode": "single"
              }
            },
            "recordTypes": {
              "demo.entry": {
                "dataSchemaVersion": 1,
                "indexes": {
                  "spread": {
                    "path": "/data/spread",
                    "type": "number",
                    "default": 0,
                    "operators": [
                      "eq",
                      "gte",
                      "lte"
                    ]
                  }
                },
                "searchableFields": [
                  "/data/content"
                ],
                "views": {
                  "rp": {
                    "format": "text",
                    "fields": [
                      {
                        "path": "/data/content"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "capabilities": {
          "demo.query": {
            "collections": [
              "entries"
            ],
            "actions": [
              "query"
            ],
            "views": [
              "rp"
            ]
          }
        }
      },
      "expect": "accept"
    },
