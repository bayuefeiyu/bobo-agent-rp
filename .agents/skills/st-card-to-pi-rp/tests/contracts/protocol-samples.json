    {
      "id": "workflow.v4.entry.valid",
      "ruleIds": [
        "struct.workflow.schemaVersion",
        "struct.workflow.owner",
        "struct.workflow.entryKind"
      ],
      "layer": "runtime+cardpack",
      "input": {
        "schemaVersion": 4,
        "ownerModuleId": "demo-module",
        "id": "demo-module/run",
        "kind": "foreground",
        "nodes": [
          {
            "id": "narrative",
            "type": "agent",
            "outputs": {
              "story": {
                "path": "story.md",
                "format": "narrative"
              }
            }
          },
          {
            "id": "finalize",
            "type": "turn-finalize",
            "dependsOn": [
              "narrative"
            ],
            "narrative": {
              "fromNode": "narrative",
              "output": "story"
            }
          }
        ]
      },
      "expect": "accept"
    },
