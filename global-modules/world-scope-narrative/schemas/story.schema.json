{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storyId",
    "seriesId",
    "sequence",
    "sourceTurn",
    "timeRange",
    "locations",
    "characters",
    "importantEntities",
    "summary",
    "content",
    "originStoryId",
    "candidateId",
    "approval"
  ],
  "properties": {
    "storyId": {
      "type": "string",
      "minLength": 1
    },
    "seriesId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "sourceTurn": {
      "type": "integer",
      "minimum": 0
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "importantEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unique"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unique": {
            "type": "boolean"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "originStoryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "runId",
        "decision"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "accept-original",
            "replace"
          ]
        }
      }
    }
  }
}
