{
  "schemaVersion": 3, "id": "create-story-candidate", "ownerModuleId": "world-scope-narrative", "title": "创作广域候选故事", "description": "创作一篇未发布的广域候选故事并返回最小结构数据。", "kind": "module-external", "agentCallable": true,
  "interface": { "inputs": { "assignment": { "type": "parameter", "required": true, "valueType": "object", "description": "包含动作、题材、时间上限及运行时技术ID的本轮委托。" }, "turn-context": { "type": "document", "required": true, "kind": "directory", "formats": ["document-workspace-snapshot"], "description": "本轮正文结束时的受控文档快照。" }, "guidance": { "type": "document", "required": false, "kind": "file", "formats": ["markdown"], "description": "面向广域模块的导演指导。" } }, "exports": { "candidate": { "format": "story-candidate", "kind": "directory", "description": "完整故事、最小元数据和运行时控制字段。" } } },
  "revision": "1", "defaults": { "agentId": "world-narrative-writer", "modelId": "pi:current", "context": { "mode": "fixed" } }, "instancePolicy": { "mode": "multiple", "maxConcurrentInstances": 4 },
  "nodes": [
    { "id": "prepare", "type": "code", "outputs": { "context": { "path": "story-context", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [{ "moduleId": "world-scope-narrative", "collectionId": "story-publications", "capabilities": ["world-story.creative.read"], "views": ["creative-index", "creative-full"], "queryBudget": { "maxRecords": 1000, "maxCharacters": 1000000 } }], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-scope-narrative/runtime/workflow/prepare-story-context.mjs", "documentIndex": { "context": { "readPolicy": "required", "authority": "binding", "appliesAt": "planning-writing-checking", "priority": 100, "description": "广域模块独立创作要求与系列资料。" } } } },
    { "id": "write", "type": "agent", "agentId": "world-narrative-writer", "dependsOn": ["prepare"], "context": { "mode": "previous-output", "fromNodes": ["prepare"] }, "prompt": "读取WORKSPACE-DOCUMENTS.md、CALL-INPUTS.md、受控正文快照、导演指导和广域模块独立资料。根据assignment只创作一篇候选；起点自行判断，结束不得晚于notAfter。需要旧资料时至多调用一次叙事记忆检索。严格把完整故事写入candidate/story.md，把最小结构数据写入candidate/metadata.json，不输出其他候选字段。", "outputs": {"candidate": {"path": "candidate", "format": "story-candidate-draft", "kind": "directory", "scope": "workflow", "retain": "run", "requiredFiles": ["story.md", "metadata.json"]}}, "delivery": {}, "workspaceHandoff": { "include": [{ "output": "candidate" }] }, "moduleAccess": [], "workflowCalls": [{ "target": "narrative-memory/narrative-memory-retrieve", "maxCalls": 1 }], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentWorkspace": true, "callInputs": ["turn-context", "guidance"], "argumentInputs": ["assignment"] } },
    { "id": "validate", "type": "code", "dependsOn": ["write"], "context": { "mode": "previous-output", "fromNodes": ["write"] }, "outputs": { "candidate": { "path": "candidate", "format": "story-candidate", "kind": "directory", "scope": "workflow", "retain": "run" } }, "moduleAccess": [], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-scope-narrative/runtime/workflow/validate-candidate.mjs" } },
    { "id": "return", "type": "workflow-return", "dependsOn": ["validate"], "exports": { "candidate": { "fromNode": "validate", "output": "candidate" } }, "outputs": {}, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } }
  ]
}
