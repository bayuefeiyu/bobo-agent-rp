{
  "schemaVersion": 2,
  "regions": [
    {
      "id": "memory-integrity", "type": "integrity-alerts", "title": "归档状态提醒",
      "description": "只提示已经越过保护与冷却但尚未覆盖的回合，以及归档后正文修订发生变化的回合；不会自动判定记忆失效或启动修复。", "spoiler": false,
      "empty": "当前没有检测到需要处理的归档问题。",
      "coverage": {
        "collectionId": "support", "view": "frontend", "readCapability": "memory.frontend.read",
        "stateRecordType": "memory.archive-state", "stateRecordId": "narrative-memory-archive-state", "lastArchivedTurnPath": "/lastArchivedTurn",
        "settingsRecordType": "memory.settings", "settingsRecordId": "narrative-memory-settings",
        "enabledPath": "/archive/enabled", "protectRecentTurnsPath": "/archive/protectRecentTurns", "archiveEveryTurnsPath": "/archive/archiveEveryTurns",
        "coverageRecordType": "memory.archive-coverage", "startTurnPath": "/startTurn", "endTurnPath": "/endTurn"
      },
      "action": {
        "workflowRegionId": "memory-workflows", "workflowId": "narrative-memory-range-repair",
        "startTurnParameter": "startTurn", "endTurnParameter": "endTurn", "operationParameter": "operation", "operationValue": "repair"
      }
    },
    {
      "id": "memory-compression-state", "type": "record-browser", "title": "当前压缩运行状态",
      "description": "这里显示当前实际使用的触发条数、目标条数和成功轮次。下方设置中的“初始化值”只用于首次建立状态，不会重置这里的当前值。", "spoiler": true,
      "collectionId": "support", "recordTypes": ["memory.maintenance-state"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 5, "maxCharacters": 20000, "filters": [], "includeInactive": true, "empty": "尚未初始化压缩运行状态。"
    },
    {
      "id": "memory-settings", "type": "settings-form", "title": "记忆模块设置",
      "description": "这些参数影响归档、检索和事件目录压缩；保存时使用当前修订保护并发编辑。", "spoiler": false,
      "collectionId": "support", "recordType": "memory.settings", "recordId": "narrative-memory-settings",
      "view": "frontend", "readCapability": "memory.frontend.read", "updateCapability": "memory.support.update", "submitLabel": "保存记忆设置",
      "fields": [
        { "path": "/archive/enabled", "label": "启用自动归档", "type": "boolean" },
        { "path": "/archive/archiveEveryTurns", "label": "归档冷却（回合）", "type": "integer", "required": true, "minimum": 1 },
        { "path": "/archive/protectRecentTurns", "label": "保护最新回合", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/archive/referenceEarlierTurns", "label": "附带早期参考回合", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/retrieval/entityQueryLimit", "label": "实体询问上限", "type": "integer", "required": true, "minimum": 1, "maximum": 100 },
        { "path": "/retrieval/initialInspectLimit", "label": "历史信息默认条数", "type": "integer", "required": true, "minimum": 1 },
        { "path": "/retrieval/supplementalInspectLimit", "label": "弹性补检条数", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/retrieval/informationLimit", "label": "事件与其他信息预算", "type": "integer", "required": true, "minimum": 1 },
        { "path": "/retrieval/elasticInformationLimit", "label": "信息弹性预算", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/retrieval/possiblePerQueryLimit", "label": "possible 每问上限", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/retrieval/customBudgetInterfaceEnabled", "label": "允许自定义检索预算", "type": "boolean" },
        { "path": "/compression/enabled", "label": "启用事件目录压缩", "type": "boolean" },
        { "path": "/compression/initialTriggerEntryCount", "label": "初始化时压缩触发条数", "type": "integer", "required": true, "minimum": 2, "help": "仅在首次建立维护状态时使用；保存此设置不会改写当前运行阈值。" },
        { "path": "/compression/initialTargetEntryCount", "label": "初始化时压缩目标条数", "type": "integer", "required": true, "minimum": 1, "help": "仅在首次建立维护状态时使用；当前运行目标见上方状态。" },
        { "path": "/compression/growthPerSuccessfulCycle", "label": "每轮阈值增长", "type": "integer", "required": true, "minimum": 0 },
        { "path": "/compression/allowManualTrigger", "label": "允许手动压缩", "type": "boolean" }
      ]
    },
    {
      "id": "memory-workflows", "type": "workflow-controls", "title": "手动归档与维护",
      "description": "这里只能启动模块静态列出的后台工作流。", "spoiler": true,
      "workflows": [
        { "id": "narrative-memory-archive", "title": "立即检查并归档", "description": "按当前冷却和保护设置检查可归档范围。", "confirm": "启动记忆归档工作流？", "parameters": [] },
        { "id": "narrative-memory-compression", "title": "手动压缩事件目录", "description": "若设置允许，将对当前有效事件目录执行语义压缩。", "confirm": "启动事件目录压缩？", "parameters": [] },
        { "id": "narrative-memory-range-repair", "title": "修复或补充回合范围", "description": "重新审视用户选择的已完成回合；可处理系统提醒，也可主动补充系统未发现的问题。", "confirm": "启动所选回合范围的两级记忆处理？", "parameters": [
          { "name": "operation", "label": "处理方式", "type": "select", "required": true, "options": ["repair", "supplement"], "default": "repair", "help": "repair用于复核矛盾或遗漏；supplement不预设旧记录错误，只主动补充。" },
          { "name": "startTurn", "label": "开始回合", "type": "integer", "required": true, "minimum": 1 },
          { "name": "endTurn", "label": "结束回合", "type": "integer", "required": true, "minimum": 1 },
          { "name": "focus", "label": "补充要求", "type": "textarea", "required": false, "help": "可说明希望重点复核的人物、关系、事件或其他内容；不会扩大回合范围。" }
        ] },
        { "id": "narrative-memory-maintenance", "title": "限定记录维护", "description": "提供任务类型和目标 ID；工作流不会扩展到未指定记录。", "confirm": "启动限定维护工作流？", "parameters": [
          { "name": "maintenanceRequest", "label": "维护请求 JSON", "type": "json", "required": true, "default": { "taskType": "repair", "targetIds": [] }, "help": "格式：{\"taskType\":\"repair\",\"targetIds\":[\"记录ID\"]}" }
        ] }
      ]
    },
    {
      "id": "entities", "type": "record-browser", "title": "全部实体", "description": "按稳定顺序分页展示所有实体记录。", "spoiler": true,
      "collectionId": "entities", "recordTypes": ["memory.entity"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000,
      "filters": [{ "id": "kind", "label": "实体类型", "index": "entityKind", "operator": "eq", "control": "select", "options": ["generic", "character", "location", "faction", "item", "ability", "species", "concept"] }],
      "includeInactive": true, "empty": "尚无实体记录。"
    },
    {
      "id": "relationships", "type": "record-browser", "title": "全部关系", "description": "包含当前与已经结束的关系记录。", "spoiler": true,
      "collectionId": "relationships", "recordTypes": ["memory.relationship"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000,
      "filters": [{ "id": "status", "label": "关系状态", "index": "status", "operator": "eq", "control": "select", "options": ["active", "ended"] }],
      "includeInactive": true, "empty": "尚无关系记录。"
    },
    {
      "id": "events", "type": "record-browser", "title": "全部事件与事件摘要", "description": "事件和压缩摘要共用一条稳定分页序列。", "spoiler": true,
      "collectionId": "events", "recordTypes": ["memory.event", "memory.event-summary"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000, "filters": [], "includeInactive": true, "empty": "尚无事件记录。"
    },
    {
      "id": "cognitions", "type": "record-browser", "title": "全部认知与传闻", "description": "包含认知内容、知情范围和传播状态。", "spoiler": true,
      "collectionId": "cognitions", "recordTypes": ["memory.cognition"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000,
      "filters": [{ "id": "stage", "label": "传播阶段", "index": "propagationStage", "operator": "eq", "control": "select", "options": ["sealed", "selective", "incidental", "active", "broadcast", "unclassified"] }],
      "includeInactive": true, "empty": "尚无认知记录。"
    },
    {
      "id": "knower-groups", "type": "record-browser", "title": "全部知情群体", "description": "查看 dynamic/fixed 群体、嵌套、排除和解析成员。", "spoiler": true,
      "collectionId": "knower-groups", "recordTypes": ["memory.knower-group"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000,
      "filters": [{ "id": "mode", "label": "成员模式", "index": "membershipMode", "operator": "eq", "control": "select", "options": ["dynamic", "fixed"] }],
      "includeInactive": true, "empty": "尚无知情群体。"
    },
    {
      "id": "support", "type": "record-browser", "title": "全部运行支持记录", "description": "设置、归档状态、维护状态与时间辅助数据。", "spoiler": true,
      "collectionId": "support", "recordTypes": ["memory.settings", "memory.archive-state", "memory.archive-coverage", "memory.maintenance-state", "memory.time-auxiliary"],
      "view": "frontend", "readCapability": "memory.frontend.read", "pageSize": 20, "maxCharacters": 80000,
      "filters": [], "includeInactive": true, "empty": "记忆模块尚未初始化运行支持记录。"
    },
    {
      "id": "source-captures", "type": "record-browser", "title": "全部来源捕获", "description": "查看其他模块为延迟归档保存的快照与逐回合资料。", "spoiler": true,
      "collectionId": "source-captures", "recordTypes": ["memory.source-capture"], "view": "frontend", "readCapability": "memory.frontend.read",
      "pageSize": 20, "maxCharacters": 80000,
      "filters": [{ "id": "module", "label": "来源模块 ID", "index": "sourceModuleId", "operator": "eq", "control": "text" }],
      "includeInactive": true, "empty": "尚无其他模块来源捕获。"
    }
  ]
}
