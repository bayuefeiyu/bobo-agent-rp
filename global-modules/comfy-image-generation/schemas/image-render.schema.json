{
  "type": "object",
  "required": ["requestId", "ordinal", "renderOrdinal", "profileId", "profileRevision", "profileDigest", "profileEffectiveDigest", "profileSnapshotId", "guideId", "connectionId", "connectionBaseUrl", "contentPrompt", "positivePrompt", "negativePrompt", "workflowDigest", "outputNodeIds", "seed", "filenamePrefix", "payloadDigest", "attemptNumber", "attemptId", "promptId", "state", "chatFolder", "outputs", "error", "errorKind", "lastCheckedAt", "submittedAt", "completedAt"],
  "properties": {
    "requestId": { "type": "string" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "renderOrdinal": { "type": "integer", "minimum": 1 },
    "profileId": { "type": "string" },
    "profileRevision": { "type": "string" },
    "profileDigest": { "type": "string" },
    "profileEffectiveDigest": { "type": "string" },
    "profileSnapshotId": { "type": "string" },
    "guideId": { "type": "string" },
    "connectionId": { "type": "string" },
    "connectionBaseUrl": { "type": "string", "minLength": 1 },
    "contentPrompt": { "type": "string" },
    "positivePrompt": { "type": "string" },
    "negativePrompt": { "type": "string" },
    "workflowDigest": { "type": "string" },
    "outputNodeIds": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "object" } },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "filenamePrefix": { "type": ["string", "null"] },
    "payloadDigest": { "type": ["string", "null"] },
    "attemptNumber": { "type": "integer", "minimum": 0 },
    "attemptId": { "type": ["string", "null"] },
    "promptId": { "type": ["string", "null"] },
    "state": { "enum": ["pending", "submitting", "submitted", "completed", "failed", "cancelled"] },
    "chatFolder": { "type": "string" },
    "outputs": { "type": "array", "items": { "type": "object", "required": ["filename", "subfolder", "type"], "properties": { "filename": { "type": "string" }, "subfolder": { "type": "string" }, "type": { "type": "string" }, "nodeId": { "type": "string" } } } },
    "error": { "type": ["string", "null"] },
    "errorKind": { "enum": [null, "pre-submit-failure", "confirmed-rejection", "submission-uncertain"] },
    "lastCheckedAt": { "type": ["string", "null"] },
    "submittedAt": { "type": ["string", "null"] },
    "completedAt": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
