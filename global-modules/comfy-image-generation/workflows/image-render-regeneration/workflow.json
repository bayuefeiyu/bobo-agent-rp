{
  "schemaVersion": 4,
  "id": "image-render-regeneration",
  "ownerModuleId": "comfy-image-generation",
  "title": "生成衍生图片",
  "kind": "global-background",
  "revision": "1",
  "instancePolicy": {
    "mode": "multiple",
    "maxConcurrentInstances": 2,
    "dedupeKey": "$.operationId"
  },
  "trigger": {
    "type": "manual"
  },
  "executionPolicy": {
    "enabled": true,
    "allowHistoricalWrites": true
  },
  "nodes": [
    {
      "id": "render",
      "type": "code",
      "retry": {
        "maxAttempts": 1
      },
      "moduleAccess": [
        {
          "moduleId": "comfy-image-generation",
          "collectionId": "requests",
          "capabilities": [
            "image.requests.prepare"
          ],
          "views": [
            "maintenance"
          ],
          "queryBudget": {
            "maxRecords": 1000,
            "maxCharacters": 1000000
          }
        },
        {
          "moduleId": "comfy-image-generation",
          "collectionId": "renders",
          "capabilities": [
            "image.renders.execute"
          ],
          "views": [
            "maintenance"
          ],
          "queryBudget": {
            "maxRecords": 1000,
            "maxCharacters": 1000000
          }
        }
      ],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "entryFile": "runtime/workflow/render-operation.mjs",
        "action": "regenerate",
        "unboundData": true
      }
    }
  ]
}
