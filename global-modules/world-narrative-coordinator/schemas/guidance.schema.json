{
  "type": "object",
  "required": ["title", "content", "status", "channels", "kind", "contextNature", "strength", "lastReviewedTurn"],
  "properties": {
    "title": { "type": "string", "minLength": 1 }, "content": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "paused", "closed"] }, "channels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "kind": { "enum": ["context", "direction", "constraint", "correction"] }, "contextNature": { "type": ["string", "null"], "enum": ["fact", "plan", "assessment", null] },
    "strength": { "enum": ["advisory", "priority", "guardrail"] }, "lastReviewedTurn": { "type": "integer", "minimum": 0 }
  }, "additionalProperties": false
}
