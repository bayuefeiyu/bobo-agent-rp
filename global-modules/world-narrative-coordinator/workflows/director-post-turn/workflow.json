{
  "schemaVersion": 4,
  "id": "director-post-turn",
  "title": "后置世界叙事统筹",
  "description": "正文完成后执行主要导演复盘，并阻塞下一次玩家输入。",
  "kind": "turn-background",
  "revision": "1",
  "defaults": {
    "agentId": "world-narrative-coordinator/world-narrative-daily-director",
    "context": {
      "mode": "fixed"
    }
  },
  "instancePolicy": {
    "mode": "single",
    "maxConcurrentInstances": 1
  },
  "trigger": {
    "type": "after-workflow",
    "blockNextTurnUntilReady": true,
    "workflowId": "narrative-controls/advanced-memory-rp",
    "documents": {
      "turn-context": {
        "fromNode": "write-narrative",
        "output": "post-turn-context"
      }
    }
  },
  "nodes": [
    {
      "id": "analyze-post-director",
      "title": "复盘当前正文",
      "type": "call",
      "target": "world-narrative-coordinator/post-director-analysis",
      "arguments": {
        "phase": "turn"
      },
      "documents": {
        "context": "trigger/turn-context"
      },
      "outputPaths": {
        "result": "post-director-result.json"
      },
      "outputs": {
        "result": {
          "path": "post-director-result.json",
          "format": "json",
          "kind": "file",
          "scope": "workflow",
          "retain": "run"
        }
      },
      "workspaceHandoff": {
        "include": [
          {
            "output": "result"
          }
        ]
      },
      "moduleAccess": [],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "triggerInputs": [
          "turn-context"
        ]
      }
    },
    {
      "id": "review",
      "type": "call",
      "target": "world-narrative-coordinator/commit-post-director-update",
      "arguments": {},
      "documents": {},
      "outputPaths": {
        "delegations": "delegations"
      },
      "outputs": {
        "delegations": {
          "path": "delegations",
          "format": "director-delegation-plan",
          "kind": "directory",
          "scope": "workflow",
          "retain": "run"
        },
        "story-context": {
          "path": "trigger/turn-context",
          "format": "document-workspace-snapshot",
          "kind": "directory",
          "scope": "turn",
          "retain": "turn"
        }
      },
      "workspaceHandoff": {
        "include": [
          {
            "output": "story-context"
          }
        ]
      },
      "moduleAccess": [],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "triggerInputs": [
          "turn-context"
        ],
        "textFile": "handoff/analyze-post-director/post-director-result.json"
      },
      "dependsOn": [
        "analyze-post-director"
      ]
    }
  ],
  "ownerModuleId": "world-narrative-coordinator",
  "executionPolicy": {
    "enabled": true,
    "allowHistoricalWrites": true
  }
}
