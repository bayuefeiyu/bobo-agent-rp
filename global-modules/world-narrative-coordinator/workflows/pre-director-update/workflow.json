{
  "schemaVersion": 3, "id": "pre-director-update", "ownerModuleId": "world-narrative-coordinator", "title": "前置导演调整", "description": "根据本轮玩家输入和正文节点已取得的资料，轻量调整私有状态与当前指导；不写归档交接。", "kind": "module-internal", "agentCallable": true,
