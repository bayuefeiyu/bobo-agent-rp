{
  "schemaVersion": 3, "id": "pre-director-update", "ownerModuleId": "world-narrative-coordinator", "title": "前置导演调整", "description": "根据本轮玩家输入和正文节点已取得的资料，轻量调整私有状态与当前指导；不写归档交接。", "kind": "module-internal", "agentCallable": true,
  "interface": { "inputs": { "context": { "type": "document", "required": true, "formats": ["document-set", "document-workspace-snapshot"], "kind": "directory", "description": "正文节点已准备的全部本轮资料、记忆检索结果和查询上下文。" } }, "exports": {} },
  "revision": "1", "defaults": { "agentId": "world-narrative-daily-director", "modelId": "pi:current", "context": { "mode": "fixed" } }, "instancePolicy": { "mode": "single", "maxConcurrentInstances": 1 }, "writeLocks": [{ "moduleId": "world-narrative-coordinator", "collectionId": "private-state" }],
  "nodes": [
    { "id": "prepare-private", "type": "call", "target": "world-narrative-coordinator/prepare-private-context", "arguments": {}, "documents": {}, "outputPaths": { "context": "director-private" }, "outputs": { "context": { "path": "director-private", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } },
    { "id": "prepare-author-future", "type": "call", "target": "card-context-library/export-context", "arguments": { "categories": ["director-future"] }, "documents": {}, "outputPaths": { "context": "author-future" }, "outputs": { "context": { "path": "author-future", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } },
    { "id": "adjust", "type": "agent", "agentId": "world-narrative-daily-director", "dependsOn": ["prepare-private", "prepare-author-future"], "context": { "mode": "previous-output", "fromNodes": ["prepare-private", "prepare-author-future"] }, "prompt": "当前为前置阶段。先读调用输入、CURRENT.md和完整DOCUMENTS.md，并明确检查上一轮刚发布的近场、广域及其他非正文模块故事。结合本轮玩家输入判断其是否与这些故事、角色、地点或可传播消息发生交集；仅在相关时更新指导、孵化、观察、玩家信号和发布清单。不要因为玩家进入过某个模块故事的地点就永久停掉该故事：若正文没有接管或玩家未理会，仍可建议原模块继续完成。除此之外只对后置导演既有成果作必要临场调整；不做常规大复盘，不创建archive-outbox，不决定是否启动深度导演。没有必要时允许返回空operations。新记录ID使用当前run.id构造稳定命名；修改已有记录必须携带expectedRevision。最终只输出JSON对象 {\"operations\": [...]}；协议版本、原子提交策略和批次ID由代码补齐。", "outputs": {}, "moduleAccess": [{ "moduleId": "world-narrative-coordinator", "collectionId": "private-state", "capabilities": ["director.private.write"], "views": ["director"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 2000000 } }], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentWorkspace": true, "callInputs": ["context"] } },
    { "id": "commit", "type": "code", "dependsOn": ["adjust"], "context": { "mode": "previous-output", "fromNodes": ["adjust"] }, "outputs": {}, "moduleAccess": [{ "moduleId": "world-narrative-coordinator", "collectionId": "private-state", "capabilities": ["director.private.write"], "views": ["director"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 2000000 } }], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-narrative-coordinator/runtime/workflow/commit-agent-batch.mjs", "sourceNode": "adjust", "allowedCollections": ["private-state"], "bindingMode": "user" } },
    { "id": "return", "type": "workflow-return", "dependsOn": ["commit"], "exports": {}, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } }
  ]
}
