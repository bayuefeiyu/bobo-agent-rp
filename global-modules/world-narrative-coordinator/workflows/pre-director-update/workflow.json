    { "id": "adjust", "type": "agent", "agentId": "world-narrative-daily-director", "dependsOn": ["prepare-private", "prepare-author-future"], "context": { "mode": "previous-output", "fromNodes": ["prepare-private", "prepare-author-future"] }, "promptFile": "prompts/modules/world-narrative-coordinator/workflows/pre-director-update/adjust.md", "outputs": {"result": {"path": "director-adjustment.json", "kind": "file", "format": "json", "scope": "workflow", "retain": "run", "jsonSchema": {"type": "object", "required": ["operations"], "properties": {"operations": {"type": "array"}}}}}, "delivery": {"primaryOutput": "result"}, "moduleAccess": [{ "moduleId": "world-narrative-coordinator", "collectionId": "private-state", "capabilities": ["director.private.write"], "views": ["director"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 2000000 } }], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentWorkspace": true, "callInputs": ["context"] } },
