{
  "schemaVersion": 4,
  "id": "director-archive-source-capture",
  "title": "捕获导演归档交接",
  "description": "把已确认的导演归档交接交给通用记忆来源捕获，并确定性回写确认。",
  "kind": "turn-background",
  "revision": "1",
  "defaults": {
    "agentId": null,
    "modelId": "pi:current",
    "context": {
      "mode": "fixed"
    }
  },
  "instancePolicy": {
    "mode": "single",
    "maxConcurrentInstances": 1
  },
  "trigger": {
    "type": "after-workflow",
    "workflowId": "world-narrative-coordinator/director-post-turn",
    "blockNextTurnUntilReady": true
  },
  "nodes": [
    {
      "id": "capture",
      "type": "code",
      "outputs": {},
      "moduleAccess": [
        {
          "moduleId": "world-narrative-coordinator",
          "collectionId": "archive-outbox",
          "capabilities": [
            "director.archive.read",
            "director.archive.confirm"
          ],
          "views": [
            "archive-source",
            "capture-confirm"
          ],
          "queryBudget": {
            "maxRecords": 1000,
            "maxCharacters": 1000000
          }
        }
      ],
      "workflowCalls": [
        "narrative-memory/narrative-memory-source-capture"
      ],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "entryFile": "runtime/capture-archive-outbox.mjs"
      }
    }
  ],
  "ownerModuleId": "world-narrative-coordinator"
}
