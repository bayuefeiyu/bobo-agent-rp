{
  "schemaVersion": 3, "id": "deep-director-planning", "ownerModuleId": "world-narrative-coordinator", "title": "深度导演推演", "description": "从冻结剧情、完整导演资料、作者未来资料和高预算记忆中生成一份完整的高层推演报告。", "kind": "module-internal", "agentCallable": false,
  "interface": { "inputs": { "triggerReasons": { "type": "parameter", "required": true, "valueType": "array", "description": "仅说明为什么启动，不指定推演任务。" }, "story-context": { "type": "document", "required": true, "kind": "directory", "formats": ["document-workspace-snapshot", "document-set"], "description": "启动时冻结的明确剧情范围；自动回合优先复用前台快照，其他入口由代码按配置窗口生成。" } }, "exports": {} },
  "revision": "1", "defaults": { "agentId": "world-narrative-deep-director", "modelId": "pi:current", "context": { "mode": "fixed" } }, "instancePolicy": { "mode": "single", "maxConcurrentInstances": 1 },
  "writeLocks": [{ "moduleId": "world-narrative-coordinator", "collectionId": "deep-workbench" }],
  "nodes": [
    { "id": "mark-running", "type": "code", "outputs": {}, "moduleAccess": [{ "moduleId": "world-narrative-coordinator", "collectionId": "deep-workbench", "capabilities": ["director.deep.write"], "views": ["deep-director"], "queryBudget": { "maxRecords": 10, "maxCharacters": 1000000 } }], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-narrative-coordinator/runtime/workflow/mark-deep-running.mjs" } },
    { "id": "prepare-private", "type": "call", "target": "world-narrative-coordinator/prepare-private-context", "dependsOn": ["mark-running"], "arguments": {}, "documents": {}, "outputPaths": { "context": "director-private" }, "outputs": { "context": { "path": "director-private", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentIndex": { "context": { "readPolicy": "required", "authority": "canonical", "appliesAt": "planning", "priority": 100, "description": "完整导演私有资料；先读CURRENT.md和DOCUMENTS.md。" } } } },
    { "id": "prepare-author-future", "type": "call", "target": "card-context-library/export-context", "dependsOn": ["mark-running"], "arguments": { "categories": ["director-future"] }, "documents": {}, "outputPaths": { "context": "author-future" }, "outputs": { "context": { "path": "author-future", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentIndex": { "context": { "readPolicy": "required", "authority": "binding", "appliesAt": "planning", "priority": 100, "description": "作者未来意图原文与完整目录。" } } } },
    { "id": "plan", "type": "agent", "agentId": "world-narrative-deep-director", "dependsOn": ["prepare-private", "prepare-author-future"], "context": { "mode": "previous-output", "fromNodes": ["prepare-private", "prepare-author-future"] }, "prompt": "以冻结剧情和本模块既定职责进行一次完整高层推演。先读WORKSPACE-DOCUMENTS.md列出的story-context、两个资料目录的DOCUMENTS.md和CURRENT.md；调用叙事记忆检索完成一次广泛检索，确有盲区时至多追加一次定向检索，budget使用本次调用提供的高预算。不要接受日常导演的详细任务，不向创作Agent直接发指令。区分已发生事实、作者未来意图、导演计划、推断与备选。为广域叙事维护worldNarrativeTopics：恰好一个active，并至少一个backup；题材应说明前提、适用条件、边界、可选角度和失效信号。若当前广域系列未结束，应结合其发展更新active意见；备用只供当前系列结束后选择。题材全部用尽本身不是启动深度推演的理由。最终只输出schemaVersion 1的JSON，字段必须为basisTurn、basisWorldTime、coverage、assumptions、invalidatingSignals、summary、content、worldNarrativeTopics、nextReviewTriggers；basisTurn必须等于当前工作流轮次，content应包含世界与剧情现状、作者意图、长期分支、势力/角色/地区走势、潜在线索、因素交汇、节奏烈度与世界逻辑风险、近期关注和复查触发。", "outputs": { "report": { "path": "deep-report.json", "format": "json", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "report" }] }, "moduleAccess": [], "workflowCalls": [{ "target": "narrative-memory/narrative-memory-retrieve", "fixedArguments": { "budget": { "entityQueryLimit": 40, "initialInspectLimit": 60, "supplementalInspectLimit": 15, "informationLimit": 45, "elasticInformationLimit": 10, "possiblePerQueryLimit": 3 } }, "maxCalls": 2 }], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentWorkspace": true, "argumentInputs": ["triggerReasons"], "callInputs": ["story-context"] } },
    { "id": "commit", "type": "code", "dependsOn": ["plan"], "context": { "mode": "previous-output", "fromNodes": ["plan"] }, "outputs": {}, "moduleAccess": [{ "moduleId": "world-narrative-coordinator", "collectionId": "deep-workbench", "capabilities": ["director.deep.write"], "views": ["deep-director"], "queryBudget": { "maxRecords": 10, "maxCharacters": 1000000 } }], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-narrative-coordinator/runtime/workflow/commit-deep-report.mjs" } },
    { "id": "return", "type": "workflow-return", "dependsOn": ["commit"], "exports": {}, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } }
  ]
}
