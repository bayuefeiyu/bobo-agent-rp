{
  "schemaVersion": 3, "id": "deep-director-planning", "ownerModuleId": "world-narrative-coordinator", "title": "深度导演推演", "description": "从冻结剧情、完整导演资料、作者未来资料和高预算记忆中生成一份完整的高层推演报告。", "kind": "module-internal", "agentCallable": false,
