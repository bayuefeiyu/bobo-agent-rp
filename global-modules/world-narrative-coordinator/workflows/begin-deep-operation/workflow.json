      "triggerReasons": { "type": "parameter", "required": true, "valueType": "array" }
    },
    "exports": {}
  },
  "revision": "1",
  "instancePolicy": { "mode": "multiple", "maxConcurrentInstances": 4, "dedupeKey": "$.operationId" },
