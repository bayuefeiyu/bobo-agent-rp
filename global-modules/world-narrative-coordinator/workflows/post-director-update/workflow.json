{
  "schemaVersion": 3, "id": "post-director-update", "ownerModuleId": "world-narrative-coordinator", "title": "后置导演复盘", "description": "在正文落地后完成主要复盘、私有状态、频道指导、可选归档交接及深度启动建议。", "kind": "module-internal", "agentCallable": false,
  "interface": { "inputs": { "phase": { "type": "parameter", "required": true, "valueType": "string", "description": "turn或opening。" }, "context": { "type": "document", "required": false, "kind": "directory", "formats": ["document-workspace-snapshot"], "description": "正文结束时的受控文档工作区快照。" } }, "exports": { "delegations": { "format": "director-delegation-plan", "kind": "directory", "description": "后置导演本轮决定启动的非正文创作委托。" } } },
  "revision": "1", "defaults": { "agentId": "world-narrative-daily-director", "modelId": "pi:current", "context": { "mode": "fixed" } }, "instancePolicy": { "mode": "single", "maxConcurrentInstances": 1 }, "writeLocks": [{ "moduleId": "world-narrative-coordinator", "collectionId": "private-state" }, { "moduleId": "world-narrative-coordinator", "collectionId": "archive-outbox" }],
  "nodes": [
    { "id": "prepare-private", "type": "call", "target": "world-narrative-coordinator/prepare-private-context", "arguments": {}, "documents": {}, "outputPaths": { "context": "director-private" }, "outputs": { "context": { "path": "director-private", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } },
    { "id": "prepare-author-future", "type": "call", "target": "card-context-library/export-context", "arguments": { "categories": ["director-future"] }, "documents": {}, "outputPaths": { "context": "author-future" }, "outputs": { "context": { "path": "author-future", "format": "document-set", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "context" }] }, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } },
    { "id": "review", "type": "agent", "agentId": "world-narrative-daily-director", "dependsOn": ["prepare-private", "prepare-author-future"], "context": { "mode": "previous-output", "fromNodes": ["prepare-private", "prepare-author-future"] }, "prompt": "读取当前phase、正文结束快照、CURRENT.md、完整私有资料目录、深度报告和全部作者未来资料。phase=turn时完成本轮主要复盘：渐进更新孵化与计划，监督世界逻辑、节奏和烈度，发现趋势时及时调整频道指导，审慎记录会话内玩家信号，每轮清空重写turn-brief-current，并按已确认三类条件填写deepRecommendation。另判断本轮是否启动近场、广域创作：近场必须明确场景；广域只能选深度导演已有的活跃题材或继续既有系列；时间与空间没有足够变化时允许不启动；深度题材用尽时暂停广域，不因此单独唤醒深度导演；两者的notAfter都只能是正文结束时的当前世界时间。把委托所需原则、约束和披露写入对应频道指导。phase=opening时只初始化，不启动故事委托。只有确实确认应归档时才创建director.archive-handoff，且必须含知情范围。将JSON对象写入工作文件并交付，且只有changes与delegations两个顶层字段：changes只含operations数组，协议版本、原子提交策略、批次ID以及archive-outbox优先顺序由代码补齐；delegations含local和world，未启动写null，启动项只写enabled、action、scene或topicId、angle、notes、notAfter、可选seriesId和originStoryId，不写技术ID。", "outputs": {"result": {"path": "director-update.json", "kind": "file", "format": "json", "scope": "workflow", "retain": "run", "jsonSchema": {"type": "object", "required": ["changes", "delegations"], "properties": {"changes": {"type": "object", "required": ["operations"], "properties": {"operations": {"type": "array"}}}, "delegations": {"type": "object"}}}}}, "delivery": {"primaryOutput": "result"}, "moduleAccess": [
      { "moduleId": "world-narrative-coordinator", "collectionId": "private-state", "capabilities": ["director.private.write"], "views": ["director"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 2000000 } },
      { "moduleId": "world-narrative-coordinator", "collectionId": "deep-workbench", "capabilities": ["director.deep.read"], "views": ["daily-director"], "queryBudget": { "maxRecords": 100, "maxCharacters": 1000000 } },
      { "moduleId": "world-narrative-coordinator", "collectionId": "archive-outbox", "capabilities": ["director.archive.write"], "views": ["director-status"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 1000000 } }
    ], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "documentWorkspace": true, "callInputs": ["context"], "argumentInputs": ["phase"] } },
    { "id": "commit", "type": "code", "dependsOn": ["review"], "context": { "mode": "previous-output", "fromNodes": ["review"] }, "outputs": {}, "moduleAccess": [
      { "moduleId": "world-narrative-coordinator", "collectionId": "private-state", "capabilities": ["director.private.write"], "views": ["director"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 2000000 } },
      { "moduleId": "world-narrative-coordinator", "collectionId": "archive-outbox", "capabilities": ["director.archive.write"], "views": ["director-status", "archive-source"], "queryBudget": { "maxRecords": 10000, "maxCharacters": 1000000 } }
    ], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-narrative-coordinator/runtime/workflow/commit-agent-batch.mjs", "sourceNode": "review", "sourceField": "changes", "allowedCollections": ["archive-outbox", "private-state"], "bindingMode": "assistant", "archiveFirst": true } },
    { "id": "export-delegations", "type": "code", "dependsOn": ["commit"], "context": { "mode": "previous-output", "fromNodes": ["review"] }, "outputs": { "delegations": { "path": "delegations", "format": "director-delegation-plan", "kind": "directory", "scope": "workflow", "retain": "run" } }, "workspaceHandoff": { "include": [{ "output": "delegations" }] }, "moduleAccess": [], "workflowCalls": [], "dataCommit": { "onNodeEnd": [] }, "metadata": { "entryFile": "features/world-narrative-coordinator/runtime/workflow/export-delegation-plan.mjs", "sourceNode": "review" } },
    { "id": "return", "type": "workflow-return", "dependsOn": ["export-delegations"], "exports": { "delegations": { "fromNode": "export-delegations", "output": "delegations" } }, "outputs": {}, "moduleAccess": [], "dataCommit": { "onNodeEnd": [] } }
  ]
}
