{
  "schemaVersion": 4,
  "id": "director-opening-bootstrap",
  "title": "开场导演初始化",
  "description": "开场展示后用代码准备基础导演状态；规划与本轮指导在实际输入后按需处理。",
  "kind": "turn-background",
  "revision": "2",
  "defaults": {
    "agentId": "world-narrative-coordinator/world-narrative-daily-director",
    "context": {
      "mode": "fixed"
    }
  },
  "instancePolicy": {
    "mode": "single",
    "maxConcurrentInstances": 1
  },
  "trigger": {
    "type": "after-opening",
    "blockNextTurnUntilReady": true
  },
  "nodes": [
    {
      "id": "bootstrap",
      "title": "准备开场基础状态",
      "type": "code",
      "outputs": {},
      "moduleAccess": [
        {
          "moduleId": "world-narrative-coordinator",
          "collectionId": "private-state",
          "capabilities": [
            "director.private.write"
          ],
          "views": [
            "director"
          ],
          "queryBudget": {
            "maxRecords": 2,
            "maxCharacters": 10000
          }
        }
      ],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "entryFile": "runtime/workflow/initialize-opening.mjs"
      }
    }
  ],
  "ownerModuleId": "world-narrative-coordinator",
  "executionPolicy": {
    "enabled": true,
    "allowHistoricalWrites": true
  }
}
