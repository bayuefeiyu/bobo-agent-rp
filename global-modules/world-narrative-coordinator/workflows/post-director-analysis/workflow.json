{
  "schemaVersion": 4,
  "id": "post-director-analysis",
  "ownerModuleId": "world-narrative-coordinator",
  "title": "后置导演只读复盘",
  "description": "依据冻结正文分析本轮变化，交付完整更新建议；分析期间不持有写锁。",
  "kind": "module-external",
  "agentCallable": false,
  "interface": {
    "inputs": {
      "phase": {
        "type": "parameter",
        "required": true,
        "valueType": "string",
        "description": "turn或opening。"
      },
      "context": {
        "type": "document",
        "required": false,
        "kind": "directory",
        "formats": [
          "document-workspace-snapshot"
        ],
        "description": "正文结束时的受控文档工作区快照。"
      }
    },
    "exports": {
      "result": {
        "format": "json",
        "kind": "file",
        "description": "完整后置分析与委托决策，交给短时提交工作流。"
      }
    }
  },
  "revision": "1",
  "defaults": {
    "agentId": "world-narrative-coordinator/world-narrative-daily-director",
    "context": {
      "mode": "fixed"
    }
  },
  "instancePolicy": {
    "mode": "multiple",
    "maxConcurrentInstances": 4
  },
  "nodes": [
    {
      "id": "prepare-private",
      "type": "call",
      "target": "world-narrative-coordinator/prepare-private-context",
      "arguments": {},
      "documents": {},
      "outputPaths": {
        "context": "director-private"
      },
      "outputs": {
        "context": {
          "path": "director-private",
          "format": "document-set",
          "kind": "directory",
          "scope": "workflow",
          "retain": "run"
        }
      },
      "workspaceHandoff": {
        "include": [
          {
            "output": "context"
          }
        ]
      },
      "moduleAccess": [],
      "dataCommit": {
        "onNodeEnd": []
      }
    },
    {
      "id": "prepare-author-future",
      "type": "call",
      "target": "card-context-library/export-context",
      "arguments": {
        "categories": [
          "director-future"
        ]
      },
      "documents": {},
      "outputPaths": {
        "context": "author-future"
      },
      "outputs": {
        "context": {
          "path": "author-future",
          "format": "document-set",
          "kind": "directory",
          "scope": "workflow",
          "retain": "run"
        }
      },
      "workspaceHandoff": {
        "include": [
          {
            "output": "context"
          }
        ]
      },
      "moduleAccess": [],
      "dataCommit": {
        "onNodeEnd": []
      }
    },
    {
      "id": "review",
      "type": "agent",
      "agentId": "world-narrative-coordinator/world-narrative-daily-director",
      "dependsOn": [
        "prepare-private",
        "prepare-author-future"
      ],
      "context": {
        "mode": "previous-output",
        "fromNodes": [
          "prepare-private",
          "prepare-author-future"
        ]
      },
      "promptFile": "prompts/workflows/post-director-update/review.md",
      "outputs": {
        "result": {
          "path": "director-update.json",
          "kind": "file",
          "format": "json",
          "scope": "workflow",
          "retain": "run",
          "jsonSchema": {
            "type": "object",
            "required": [
              "changes",
              "delegations"
            ],
            "properties": {
              "changes": {
                "type": "object",
                "required": [
                  "operations"
                ],
                "properties": {
                  "operations": {
                    "type": "array"
                  }
                }
              },
              "delegations": {
                "type": "object"
              }
            }
          }
        }
      },
      "delivery": {
        "primaryOutput": "result"
      },
      "moduleAccess": [
        {
          "moduleId": "world-narrative-coordinator",
          "collectionId": "private-state",
          "capabilities": [
            "director.private.read"
          ],
          "views": [
            "director"
          ],
          "queryBudget": {
            "maxRecords": 10000,
            "maxCharacters": 2000000
          }
        },
        {
          "moduleId": "world-narrative-coordinator",
          "collectionId": "deep-workbench",
          "capabilities": [
            "director.deep.read"
          ],
          "views": [
            "daily-director"
          ],
          "queryBudget": {
            "maxRecords": 100,
            "maxCharacters": 1000000
          }
        },
        {
          "moduleId": "world-narrative-coordinator",
          "collectionId": "archive-outbox",
          "capabilities": [
            "director.archive.read"
          ],
          "views": [
            "director-status",
            "archive-source"
          ],
          "queryBudget": {
            "maxRecords": 10000,
            "maxCharacters": 1000000
          }
        }
      ],
      "workflowCalls": [],
      "dataCommit": {
        "onNodeEnd": []
      },
      "metadata": {
        "documentWorkspace": true,
        "callInputs": [
          "context"
        ],
        "argumentInputs": [
          "phase"
        ],
        "softBudget": {
          "modelRequests": 12,
          "outputTokens": 8000,
          "elapsedSeconds": 90
        }
      }
    },
    {
      "id": "return",
      "type": "workflow-return",
      "dependsOn": [
        "review"
      ],
      "exports": {
        "result": {
          "fromNode": "review",
          "output": "result"
        }
      },
      "moduleAccess": [],
      "dataCommit": {
        "onNodeEnd": []
      }
    }
  ],
  "executionPolicy": {
    "enabled": true,
    "allowHistoricalWrites": true
  }
}
