# This repository publishes reusable project skills, selected global modules, templates, and root documentation.
/*
!/.agents/
!/.gitattributes
!/.gitignore
!/README.md
!/PROJECT_STATUS.md
!/DEVELOPER-GUIDE.md
!/DEVELOPMENT-HISTORY.md
!/TROUBLESHOOTING.md
!/PI-PLAY-CONTEXT-ISOLATION.md
!/PI-RP-DEVELOPMENT-SCOPE.md
!/PI-RP-INFRASTRUCTURE-UPGRADE-BACKLOG.md
!/PROJECT-RELEASE-MANIFEST.json
# Root development and verification entry points. These are development-only and
# are never copied into a card pack or the card runtime.
!/package.json
!/package-lock.json
!/tsconfig.check.json
!/scripts/
!/scripts/**
!/types/
!/types/**
!/.github/
!/.github/**
!/global-modules/
/global-modules/*
!/global-modules/comfy-image-generation/
!/global-modules/comfy-image-generation/**
!/global-modules/narrative-memory/
!/global-modules/narrative-memory/**
!/global-modules/narrative-controls/
!/global-modules/narrative-controls/**
!/global-modules/local-scene-narrative/
!/global-modules/local-scene-narrative/**
!/global-modules/world-scope-narrative/
!/global-modules/world-scope-narrative/**
!/global-modules/world-narrative-coordinator/
!/global-modules/world-narrative-coordinator/**
!/.pi/
/.pi/*
!/.pi/APPEND_SYSTEM.md

/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/st-card-to-pi-rp/
!/.agents/skills/design-pi-rp-data/
!/.agents/skills/create-pi-rp-feature-module/
!/.agents/skills/codex-delegate-bounded-tasks/
!/.agents/skills/audit-and-upgrade-pi-rp-card/
!/.agents/skills/adapt-comfyui-workflow/
!/.agents/skills/manage-pi-rp-config-ui/
!/.agents/skills/debug-pi-rp-play/

# Local-only documents, diagnostic tools, logs, results, and temporary fixtures.
/local-development-records/

**/__pycache__/
**/*.py[cod]
